    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
